# Application
APP_NAME=ePA Platform
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database — required for audit persistence and token grants
DATABASE_URL=postgresql+asyncpg://epa:changeme@localhost:5432/epa_platform

# JWT / JWKS (RS256 — no symmetric JWT_SECRET_KEY)
JWT_KEY_ID=epa-platform-rs256-v1
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
OAUTH_ISSUER=https://api.epa-platform.example.com
OAUTH_AUDIENCE=https://api.epa-platform.example.com

# SMART OAuth clients (JSON dict: client_id -> secret)
# OAUTH_CLIENTS={"epa-smart-client":"dev-secret-change-me"}

# KMS envelope encryption (mock CMK in dev; replace with AWS KMS ARN in prod)
PHI_ENCRYPTION_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/mock-cmk
PHI_ENCRYPTION_ALGORITHM=AES-256-GCM

# Audit
AUDIT_LOG_IMMUTABLE=true
AUDIT_HASH_ALGORITHM=SHA-256

CORS_ORIGINS=["http://localhost:3000"]
